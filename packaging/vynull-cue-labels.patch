+// Report a write as persisted only after the cue store confirms its flush.
+func (s *Server) cueWriteReceipt(w http.ResponseWriter) {
+	persisted := false
+	if store, ok := s.Cues.(interface{ Flush() error }); ok {
+		if err := store.Flush(); err != nil {
+			jsonError(w, "Cue changed in memory but disk persistence failed: "+err.Error(), http.StatusInternalServerError)
+			return
+		}
+		persisted = true
+	}
+	writeJSON(w, struct {
+		OK        bool `json:"ok"`
+		Persisted bool `json:"persisted"`
+	}{true, persisted})
+}
