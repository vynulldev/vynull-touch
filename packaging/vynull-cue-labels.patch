+// SPDX-License-Identifier: GPL-3.0-or-later
+package api
+
+import (
+	"encoding/json"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/vynulldev/vynull/dbserver"
+)
+
+func TestCueLabelWriteReadbackAndRestart(t *testing.T) {
+	dir := t.TempDir()
+	store := dbserver.NewCueStore(dir)
+	defer store.Close()
+	s := &Server{Cues: &CueStoreAdapter{Store: store}}
+	body := `{"number":2,"type":"loop","time_ms":1125,"loop_ms":3125,"color_id":42,"label":"Drop α"}`
+	w := httptest.NewRecorder()
+	s.handleCues(w, httptest.NewRequest("POST", "/api/tracks/7/cues", strings.NewReader(body)))
+	if w.Code != 200 || !strings.Contains(w.Body.String(), `"persisted":true`) {
+		t.Fatalf("write: %d %s", w.Code, w.Body.String())
+	}
+	reloaded := dbserver.NewCueStore(dir)
+	defer reloaded.Close()
+	s.Cues = &CueStoreAdapter{Store: reloaded}
+	w = httptest.NewRecorder()
+	s.handleCues(w, httptest.NewRequest("GET", "/api/tracks/7/cues", nil))
+	var cues []CueInfo
+	if err := json.Unmarshal(w.Body.Bytes(), &cues); err != nil {
+		t.Fatal(err)
+	}
+	var expected CueInfo
+	if err := json.Unmarshal([]byte(body), &expected); err != nil {
+		t.Fatal(err)
+	}
+	if len(cues) != 1 || cues[0] != expected {
+		t.Fatalf("readback after restart: %+v", cues)
+	}
+	w = httptest.NewRecorder()
+	s.handleCues(w, httptest.NewRequest("DELETE", "/api/tracks/7/cues/2", nil))
+	if w.Code != 200 || !strings.Contains(w.Body.String(), `"persisted":true`) {
+		t.Fatalf("delete: %d %s", w.Code, w.Body.String())
+	}
+	if _, err := os.Stat(filepath.Join(dir, "cues_7.json")); !os.IsNotExist(err) {
+		t.Fatalf("cue file remains: %v", err)
+	}
+}
+
+func TestCueDiskFailureIsNotReportedPersisted(t *testing.T) {
+	dir := filepath.Join(t.TempDir(), "cues")
+	store := dbserver.NewCueStore(dir)
+	defer store.Close()
+	if err := os.Remove(dir); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(dir, []byte("not a directory"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	s := &Server{Cues: &CueStoreAdapter{Store: store}}
+	w := httptest.NewRecorder()
+	s.handleCues(w, httptest.NewRequest("POST", "/api/tracks/7/cues", strings.NewReader(`{"number":1,"type":"cue","time_ms":0,"loop_ms":-1,"label":"Start"}`)))
+	if w.Code != 500 || strings.Contains(w.Body.String(), `"persisted":true`) {
+		t.Fatalf("unexpected persistence success: %d %s", w.Code, w.Body.String())
+	}
+}
